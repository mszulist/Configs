{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4096
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 30000
  },
  "share": "disabled",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        // Ranking method (2026-08-08): order within each category by benchmark evidence from
        // 2026-08 leaderboards (LiveCodeBench, GPQA, AIME, BigCodeBench, Aider Polyglot).
        // "REMOVE CANDIDATE" markers note models kept for convenience but outclassed by others
        // in the same category; drop them to slim the list.

        // === Primary: reasoning-heavy code work (RE, deep debugging) ===
        // BEST: r1:8b is DeepSeek-R1-0528 (Qwen3-based refresh) — outranks the r1 14b/7b on LiveCodeBench
        // (60.5 vs 53.1/37.6), GPQA, AIME, at half the VRAM (~5.2GB vs ~9GB).
        "deepseek-r1:8b": { "name": "DeepSeek R1 8b", "tool_call": true, "reasoning": true, "limit": { "context": 16384, "output": 4096 } },  // top reasoning/code pick, planning, deep debugging
        "qwen2.5-coder:14b": { "name": "Qwen2.5 Coder 14b", "tool_call": true, "limit": { "context": 16384, "output": 8192 } },   // best code quality, agent default
        "qwen3:14b": { "name": "Qwen3 14b", "tool_call": true, "reasoning": true, "limit": { "context": 16384, "output": 4096 } },      // reasoning + native tools
        // REMOVE CANDIDATE: deepseek-r1:14b — outclassed by :8b on every reasoning/code benchmark, ~2x VRAM.
        "deepseek-r1:14b": { "name": "DeepSeek R1 14b", "tool_call": true, "reasoning": true, "limit": { "context": 16384, "output": 4096 } },
        // REMOVE CANDIDATE: deepseek-r1:7b — worst of the three (LiveCodeBench 37.6); :8b is same speed class with higher quality.
        "deepseek-r1:7b": { "name": "DeepSeek R1 7b", "tool_call": true, "reasoning": true, "limit": { "context": 16384, "output": 4096 } },  // fastest reasoning

        // === Multimodal (vision/audio + text) ===
        "qwen3-vl:8b": { "name": "Qwen3 VL 8b", "tool_call": true, "limit": { "context": 16384, "output": 4096 } },        // screenshots, UI bugs; best vision of the two (wins 6/7 vision benchmarks vs Gemma 3 12B)
        // REMOVE CANDIDATE: gemma4:12b — tool_call: false (unusable in opencode's tool-driven flows) and
        // outclassed by qwen3-vl:8b on reasoning-heavy vision; keep only if you need audio input.
        "gemma4:12b": { "name": "Gemma4 12b", "tool_call": false, "limit": { "context": 16384, "output": 4096 } },   // vision + audio, heavier brain

        // === Fast / lightweight ===
        "qwen2.5-coder:7b": { "name": "Qwen2.5 Coder 7b", "tool_call": true, "limit": { "context": 16384, "output": 8192 } },    // fastest solid code; BigCodeBench 41.0, elite for its size
        "qwen2.5:7b": { "name": "Qwen2.5 7b", "tool_call": true, "limit": { "context": 32768, "output": 8192 } },          // 32k ctx, long docs
        "qwen3.5:4b": { "name": "Qwen3.5 4b", "tool_call": true, "limit": { "context": 16384, "output": 4096 } },          // smallest; titles, quick chat, small_model

        // === General all-rounder ===
        // REMOVE CANDIDATE: this whole category — you don't need it (no boilerplate work). Both overlap
        // qwen2.5-coder:14b / qwen3:14b and trail them on every coding/reasoning benchmark.
        "qwen3.5:9b": { "name": "Qwen3.5 9b", "tool_call": true, "limit": { "context": 16384, "output": 8192 } },           // mixed chat+code+tools
        "mistral:latest": { "name": "Mistral 7b", "tool_call": true, "limit": { "context": 16384, "output": 4096 } },           // generic filler

        // Disabled 2026-08-08: opencode always sends tool definitions on every request (upstream
        // bug https://github.com/anomalyco/opencode/issues/35432, unfixed through v1.18.15), so the
        // `tool_call` flag is ignored and Ollama rejects these models with 400 "does not support
        // tools". None can be used in opencode's tool-driven workflow until the upstream fix lands;
        // the ones that could be useful (deepseek-coder-v2:16b, llama3) are outclassed by the kept
        // models. Re-enable once the fix is released.
        // "deepseek-coder-v2:16b": { "name": "DeepSeek Coder V2 16b", "tool_call": true, "limit": { "context": 8192, "output": 4096 } },
        // "deepseek-coder:1.3b": { "name": "DeepSeek Coder 1.3b", "tool_call": true, "limit": { "context": 16384, "output": 4096 } },
        // "gemma:2b": { "name": "Gemma 2b", "tool_call": false, "limit": { "context": 8192, "output": 4096 } },
        // "llama3:latest": { "name": "Llama3 8b", "tool_call": false, "limit": { "context": 8192, "output": 4096 } },
        // "phi:latest": { "name": "Phi", "tool_call": false, "limit": { "context": 2048, "output": 4096 } },
        // "tinyllama:latest": { "name": "Tinyllama", "tool_call": false, "limit": { "context": 2048, "output": 4096 } }
      }
    }
  }
}
