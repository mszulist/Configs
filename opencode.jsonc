{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4096
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 30000
  },
  "share": "disabled",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "deepseek-r1:14b": { "name": "DeepSeek R1 14b", "tool_call": true, "reasoning": true, "limit": { "context": 16384, "output": 4096 } },
        "deepseek-r1:7b": { "name": "DeepSeek R1 7b", "tool_call": true, "reasoning": true, "limit": { "context": 16384, "output": 4096 } },
        "deepseek-r1:8b": { "name": "DeepSeek R1 8b", "tool_call": true, "reasoning": true, "limit": { "context": 16384, "output": 4096 } },
        "qwen3-vl:8b": { "name": "Qwen3 VL 8b", "tool_call": true, "limit": { "context": 16384, "output": 4096 } },
        "qwen2.5-coder:7b": { "name": "Qwen2.5 Coder 7b", "tool_call": true, "limit": { "context": 16384, "output": 8192 } },
        "qwen3.5:9b": { "name": "Qwen3.5 9b", "tool_call": true, "limit": { "context": 16384, "output": 8192 } },
        "gemma4:12b": { "name": "Gemma4 12b", "tool_call": false, "limit": { "context": 16384, "output": 4096 } },
        "qwen2.5-coder:14b": { "name": "Qwen2.5 Coder 14b", "tool_call": true, "limit": { "context": 16384, "output": 8192 } },
        "mistral:latest": { "name": "Mistral 7b", "tool_call": true, "limit": { "context": 16384, "output": 4096 } },
        "qwen2.5:7b": { "name": "Qwen2.5 7b", "tool_call": true, "limit": { "context": 32768, "output": 8192 } },
        // Disabled 2026-08-08: opencode always sends tool definitions on every request (upstream
        // bug https://github.com/anomalyco/opencode/issues/35432, unfixed through v1.18.15), so the
        // `tool_call` flag is ignored and Ollama rejects these models with 400 "does not support
        // tools". None can be used in opencode's tool-driven workflow until the upstream fix lands;
        // the ones that could be useful (deepseek-coder-v2:16b, llama3) are outclassed by the kept
        // models. Re-enable once the fix is released.
        // "deepseek-coder-v2:16b": { "name": "DeepSeek Coder V2 16b", "tool_call": true, "limit": { "context": 8192, "output": 4096 } },
        // "deepseek-coder:1.3b": { "name": "DeepSeek Coder 1.3b", "tool_call": true, "limit": { "context": 16384, "output": 4096 } },
        // "gemma:2b": { "name": "Gemma 2b", "tool_call": false, "limit": { "context": 8192, "output": 4096 } },
        // "llama3:latest": { "name": "Llama3 8b", "tool_call": false, "limit": { "context": 8192, "output": 4096 } },
        // "phi:latest": { "name": "Phi", "tool_call": false, "limit": { "context": 2048, "output": 4096 } },
        // "tinyllama:latest": { "name": "Tinyllama", "tool_call": false, "limit": { "context": 2048, "output": 4096 } }
      }
    }
  }
}
